# Copy this file to backend/.env and fill in the values.
PORT=3001
CLIENT_ORIGINS=http://localhost:5173

# Firebase Admin: use EITHER a service-account file path...
# (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# ...OR these three values from that same file:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: AI coaching insights in reports (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: IoT band
SENSOR_API_KEY=changeme123
FSR_MIN=0
FSR_MAX=1023
